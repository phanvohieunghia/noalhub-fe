# Origin của backend REST (OpenAPI: http://localhost:3101/docs). Tiền tố /api
# được services/config.ts tự gắn, nên giá trị ở đây là ORIGIN THUẦN — có kèm
# /api cũng không sao, config tự cắt. Browser gọi thẳng vào đây nên bắt buộc
# phải là NEXT_PUBLIC_ (giá trị bị inline lúc `next build`).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3101

# Socket.IO gateway (feature chat). Tách riêng vì production thường khác
# host/scheme (wss://). Bỏ trống thì config suy từ API origin (http -> ws).
NEXT_PUBLIC_WS_URL=ws://localhost:3101

# OAuth callback URL do BACKEND cấu hình — spec không nhận `redirect_uri`, nên
# frontend không cần khai báo origin của mình ở đây.
