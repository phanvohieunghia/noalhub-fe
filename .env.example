# Base URL của backend REST (OpenAPI: http://localhost:3101/docs). Path trong
# spec không có tiền tố nên KHÔNG thêm /api. Browser gọi thẳng vào đây nên bắt
# buộc phải là NEXT_PUBLIC_ (giá trị bị inline lúc `next build`).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3101

# OAuth callback URL do BACKEND cấu hình — spec không nhận `redirect_uri`, nên
# frontend không cần khai báo origin của mình ở đây.
