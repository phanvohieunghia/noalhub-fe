# Admin build ĐỘC LẬP với web: `NEXT_PUBLIC_*` bị inline lúc `next build`, nên
# hai app phải build riêng nếu trỏ về origin khác nhau — không dùng lại được
# artifact của nhau. Xem docs/monorepo-plan.md §2.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3101

# Admin không dùng chat realtime, để trống là được. Giữ biến ở đây vì
# `@noalhub/api/chat` vẫn nằm trong package dùng chung.
NEXT_PUBLIC_WS_URL=ws://localhost:3101


# Port của dev server / `next start` cho RIÊNG app này — xem chú thích ở
# apps/web/.env.example. Phải khác web, nếu không hai app đá nhau khi `pnpm dev`.
PORT=3002
