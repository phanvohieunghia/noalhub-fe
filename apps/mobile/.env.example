# For simulator: http://localhost:3101 or http://10.0.2.2:3101 (Android emulator)
# For physical devices: replace with your Mac's LAN IP, e.g. http://192.168.1.15:3101
EXPO_PUBLIC_API_BASE_URL=http://localhost:3101

# Optional WebSocket URL. If omitted, derives ws:// or wss:// from EXPO_PUBLIC_API_BASE_URL
EXPO_PUBLIC_WS_URL=ws://localhost:3101
