# Origin của backend REST (OpenAPI: http://localhost:3101/docs). Tiền tố /api
# được services/config.ts tự gắn, nên giá trị ở đây là ORIGIN THUẦN — có kèm
# /api cũng không sao, config tự cắt. Browser gọi thẳng vào đây nên bắt buộc
# phải là NEXT_PUBLIC_ (giá trị bị inline lúc `next build`).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3101

# Socket.IO gateway (feature chat). Tách riêng vì production KHÔNG dùng chung
# host với REST: nginx bật `http2 on` cho domain API, mà HTTP/2 cấm header
# `Connection`/`Upgrade` nên WebSocket không bắt tay được (Engine.IO trả 400,
# client thấy close code 1006). Vì vậy production có domain riêng không bật h2:
#
#   NEXT_PUBLIC_WS_URL=wss://ws-noalhub.duckdns.org
#
# Bỏ trống thì config suy từ API origin (http -> ws) — chỉ đúng ở local.
NEXT_PUBLIC_WS_URL=ws://localhost:3101

# OAuth callback URL do BACKEND cấu hình — spec không nhận `redirect_uri`, nên
# frontend không cần khai báo origin của mình ở đây.

# Port của dev server / `next start` cho RIÊNG app này. Next không tự đọc `PORT`
# từ .env (HTTP server bind trước khi env file được load), nên script `dev`/`start`
# nạp file này bằng `node --env-file-if-exists=` rồi mới gọi Next. Biến của shell
# vẫn thắng file: `PORT=4100 pnpm dev:web`.
PORT=3000

# Origin công khai của chính app này. Dùng cho `metadataBase`, canonical, OG,
# sitemap, RSS và JSON-LD của blog (docs/blog-plan.md §6.1). `NEXT_PUBLIC_` vì
# nó bị inline lúc build — trên production giá trị đến từ khối `env:` của
# .github/workflows/publish.yml, không phải từ .env trên VPS.
NEXT_PUBLIC_APP_URL=http://localhost:3100

# --- Hai biến RUNTIME của blog (KHÔNG có tiền tố NEXT_PUBLIC_) ---------------
#
# Chúng được đọc lúc CHẠY chứ không lúc build, nên trên production chúng nằm ở
# khối `environment:` của service `web` trong docker-compose.prod.yml bên repo BE
# — khác hẳn ba biến NEXT_PUBLIC_ ở trên. Ở local thì bỏ trống cũng chạy.

# Base URL để Server Component fetch backend (docs/blog-plan.md §4.3). Bỏ trống
# thì server.ts rơi về NEXT_PUBLIC_API_BASE_URL — đúng ở local, nhưng trên VPS thì
# request sẽ đi ra internet rồi vòng qua nginx quay lại chính máy đó.
#   API_INTERNAL_URL=http://app:3000

# Secret của POST /api/revalidate (docs/blog-plan.md §5.2c). Backend gọi vào đây
# sau khi publish; phải KHỚP `WEB_REVALIDATE_SECRET` bên repo BE. Bỏ trống thì
# route handler trả 503 và blog rơi về ISR 60 giây — hành vi fallback §5.1.
#   WEB_REVALIDATE_SECRET=
